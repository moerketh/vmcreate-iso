# VMCreate Plymouth theme
#
# Wordmark, a thin progress track and one status line. The host (VMCreate)
# drives the text over SSH-over-vsock with stock plymouth commands:
#
#   sudo plymouth display-message --text="Cloning disk 1 of 2"
#   sudo plymouth system-update --progress=42    # 1..100 = determinate bar
#   sudo plymouth system-update --progress=0     # back to the sweep
#
# Without a host the screen still shows a sensible default line.
# Graphics are generated by splash/render.py; layout mirrors its preview.

Window.SetBackgroundTopColor(0.086, 0.086, 0.118);     # #16161e
Window.SetBackgroundBottomColor(0.102, 0.106, 0.149);  # #1a1b26

global.version_text = "vmcreate-iso @VMCREATE_ISO_VERSION@";
global.font = "Ubuntu 16";
global.small_font = "Ubuntu Mono 11";

wordmark.original = Image("wordmark.png");
wordmark.original_red = Image("wordmark_red.png");
wordmark.sprite = Sprite();

track.image = Image("track.png");
track.image_red = Image("track_red.png");
track.sprite = Sprite(track.image);

bar.original = Image("bar.png");
bar.original_red = Image("bar_red.png");
bar.segment = bar.original.Scale(96, bar.original.GetHeight());
bar.segment_red = bar.original_red.Scale(96, bar.original_red.GetHeight());
bar.sprite = Sprite(bar.segment);

cursor.image = Image("cursor.png");
cursor.image_red = Image("cursor_red.png");
cursor.sprite = Sprite(cursor.image);

message.sprite = Sprite();

version.sprite = Sprite();

global.frame = 0;
global.progress = 0;          # 0 = indeterminate sweep; (0, 1] = fraction done
global.layout_width = 0;
global.layout_height = 0;
global.track_x = 0;
global.track_y = 0;
global.message_y = 0;
global.message_text = "";
global.default_text = "Preparing your virtual machine";

#----------------------------------------- Easter eggs --------------------------------
#
# Any key at the console cycles: normal → flip → red → rain → normal.
# Flip: the wordmark splits into per-letter sprites that spin 180° like
# dominoes. Red: the whole theme swaps to the red palette (graphics
# generated by render.py). Rain: letters fall behind the content.
# In every state, printable characters tumble off the status line.
# Escape never reaches the script (plymouthd keeps it for the console view).

global.palette = "normal";   # "normal" or "red"
palettes.normal.bg_top = [0.086, 0.086, 0.118];
palettes.normal.bg_bottom = [0.102, 0.106, 0.149];
palettes.normal.message = [0.663, 0.694, 0.839];
palettes.normal.version = [0.337, 0.373, 0.537];
palettes.red.bg_top = [0.122, 0.071, 0.086];
palettes.red.bg_bottom = [0.153, 0.082, 0.110];
palettes.red.message = [0.878, 0.686, 0.729];
palettes.red.version = [0.549, 0.349, 0.420];

# Per-letter sprites: (glyph, block offset) mirrors render.py word_offsets()
# and BLOCK. Letter PNGs carry symmetric 29 px margins (render.py
# LETTER_PAD) so Rotate() pivots exactly on the glyph centre.
letters.blocks = [0, 8, 18, 26, 34, 42, 50, 57];
letters.files = ["letters/v.png", "letters/m.png", "letters/c.png", "letters/r.png",
                 "letters/e.png", "letters/a.png", "letters/t.png", "letters/e.png"];
letters.files_red = ["letters_red/v.png", "letters_red/m.png", "letters_red/c.png",
                     "letters_red/r.png", "letters_red/e.png", "letters_red/a.png",
                     "letters_red/t.png", "letters_red/e.png"];
letters.images = [];
letters.images_red = [];
letters.rain = [];
letters.rain_red = [];
for (i = 0; i < 8; i++) {
  img = Image(letters.files[i]);
  letters.images[i] = img;
  letters.images_red[i] = Image(letters.files_red[i]);
  letters.rain[i] = img.Scale(Math.Int(img.GetWidth() * 0.45), Math.Int(img.GetHeight() * 0.45));
  img_red = letters.images_red[i];
  letters.rain_red[i] = img_red.Scale(Math.Int(img_red.GetWidth() * 0.45), Math.Int(img_red.GetHeight() * 0.45));
}
global.block = 10;           # px per glyph block at full resolution (render.py BLOCK)
global.wordmark_scale = 1;
global.wordmark_x = 0;
global.wordmark_y = 0;

# States: 0 normal, 1 flip, 2 red, 3 rain.
global.state = 0;
global.state_start = 0;

flip.sprites = [];
flip.cx = []; flip.cy = [];
flip.last_angle = [];
for (i = 0; i < 8; i++) {
  flip.sprites[i] = Sprite();
  flip.sprites[i].SetOpacity(0);
  flip.sprites[i].SetZ(1);
  flip.cx[i] = 0; flip.cy[i] = 0;
  flip.last_angle[i] = -2;
}

rain.count = 22;
rain.sprites = [];
rain.x = []; rain.y = []; rain.vy = []; rain.glyph = [];
for (i = 0; i < rain.count; i++) {
  rain.sprites[i] = Sprite();
  rain.sprites[i].SetOpacity(0);
  rain.sprites[i].SetZ(0);   # behind wordmark (1), track (2), bar (3), message (4)
  rain.x[i] = 0; rain.y[i] = 0; rain.vy[i] = 2; rain.glyph[i] = 0;
}

fall.max = 32;               # typed characters tumbling off the status line
fall.sprites = [];
fall.live = []; fall.vx = []; fall.vy = [];
for (i = 0; i < fall.max; i++) {
  fall.sprites[i] = Sprite();
  fall.sprites[i].SetOpacity(0);
  fall.sprites[i].SetZ(5);
  fall.live[i] = 0; fall.vx[i] = 0; fall.vy[i] = 0;
}

# Uniform [0, 1). Older Plymouth (24.004 on noble) builds Math.Random()
# from one 32-bit mrand48() but divides by the 64-bit LONG_MAX, so it never
# exceeds ~2^-32: every "random" pick collapses to 0 (x = 0, glyph V).
# Scale such values back up; newer Plymouth passes through unchanged.
fun random() {
  r = Math.Random();
  if (r < 0.000001)
    r = r * 4294967296;
  return Math.Min(r, 0.999999);
}

# Place the letter sprites to tile exactly over the wordmark sprite.
fun position_letters() {
  s = global.wordmark_scale;
  y = global.wordmark_y - Math.Int((29 - 24) * s);
  for (i = 0; i < 8; i++) {
    img = letters.images[i];
    if (global.palette == "red")
      img = letters.images_red[i];
    w = Math.Int(img.GetWidth() * s);
    h = Math.Int(img.GetHeight() * s);
    x = global.wordmark_x + Math.Int((24 + letters.blocks[i] * global.block) * s) - Math.Int(29 * s);
    flip.cx[i] = x + w / 2;
    flip.cy[i] = y + h / 2;
  }
}

fun set_palette(name) {
  global.palette = name;
  p = palettes[name];
  Window.SetBackgroundTopColor(p.bg_top[0], p.bg_top[1], p.bg_top[2]);
  Window.SetBackgroundBottomColor(p.bg_bottom[0], p.bg_bottom[1], p.bg_bottom[2]);
  if (name == "red")
    cursor.sprite.SetImage(cursor.image_red);
  else
    cursor.sprite.SetImage(cursor.image);
  layout();                  # wordmark, track, version, bar, letter geometry
  set_message(global.message_text);
}

fun apply_state() {
  if (global.state != 1) {
    wordmark.sprite.SetOpacity(1);
    for (i = 0; i < 8; i++) {
      flip.sprites[i].SetOpacity(0);
      flip.last_angle[i] = -2;
    }
  } else {
    wordmark.sprite.SetOpacity(0);
    for (i = 0; i < 8; i++)
      flip.last_angle[i] = -2;
  }
  if (global.state == 2 && global.palette != "red")
    set_palette("red");
  if (global.state != 2 && global.palette == "red")
    set_palette("normal");
  if (global.state != 3)
    for (i = 0; i < rain.count; i++)
      rain.sprites[i].SetOpacity(0);
  else
    rain_start();
}

fun cycle_state() {
  global.state = (global.state + 1) % 4;
  global.state_start = global.frame;
  apply_state();
}

# Domino flip: letter i starts 8 frames after its predecessor, spins over
# 30 frames with a smoothstep ease; only re-rotate when the angle changed.
fun update_flip() {
  for (i = 0; i < 8; i++) {
    t = global.frame - global.state_start - i * 8;
    if (t < 0) t = 0;
    if (t > 30) t = 30;
    u = t / 30;
    angle = Math.Pi * u * u * (3 - 2 * u);
    a = Math.Int(angle * 1000);
    if (a == Math.Int(flip.last_angle[i] * 1000))
      continue;
    flip.last_angle[i] = angle;
    img = letters.images[i];
    if (global.palette == "red")
      img = letters.images_red[i];
    if (angle > 0)
      img = img.Rotate(angle);
    s = global.wordmark_scale;
    img = img.Scale(Math.Int(img.GetWidth() * s), Math.Int(img.GetHeight() * s));
    flip.sprites[i].SetImage(img);
    flip.sprites[i].SetPosition(Math.Int(flip.cx[i] - img.GetWidth() / 2),
                                Math.Int(flip.cy[i] - img.GetHeight() / 2), 1);
    flip.sprites[i].SetOpacity(1);
  }
}

fun rain_start() {
  w = global.layout_width;
  h = global.layout_height;
  for (i = 0; i < rain.count; i++) {
    rain.x[i] = Math.Int(random() * Math.Max(1, w - 60));
    rain.y[i] = Math.Int(random() * (h + 76)) - 76;   # pre-scattered: full rain at once
    rain.vy[i] = 1.5 + random() * 2.5;
    rain.glyph[i] = Math.Int(random() * 8);
    img = letters.rain[rain.glyph[i]];
    if (global.palette == "red")
      img = letters.rain_red[rain.glyph[i]];
    rain.sprites[i].SetImage(img);
    rain.sprites[i].SetPosition(rain.x[i], Math.Int(rain.y[i]), 0);
    rain.sprites[i].SetOpacity(0.3);
  }
}

fun update_rain() {
  w = global.layout_width;
  h = global.layout_height;
  for (i = 0; i < rain.count; i++) {
    rain.y[i] += rain.vy[i];
    if (rain.y[i] > h) {
      rain.x[i] = Math.Int(random() * Math.Max(1, w - 60));
      rain.y[i] = -76;
      rain.vy[i] = 1.5 + random() * 2.5;
      rain.glyph[i] = Math.Int(random() * 8);
      img = letters.rain[rain.glyph[i]];
      if (global.palette == "red")
        img = letters.rain_red[rain.glyph[i]];
      rain.sprites[i].SetImage(img);
      rain.sprites[i].SetPosition(Math.Int(rain.x[i]), Math.Int(rain.y[i]), 0);
    } else {
      rain.sprites[i].SetY(Math.Int(rain.y[i]));
    }
  }
}

fun spawn_fall(char) {
  for (i = 0; i < fall.max; i++) {
    if (fall.live[i] == 0) {
      p = palettes[global.palette];
      img = Image.Text(char, p.message[0], p.message[1], p.message[2], 1, global.font);
      fall.sprites[i].SetImage(img);
      fall.sprites[i].SetPosition(message.sprite.GetX() + message.image.GetWidth() + 8,
                                  global.message_y, 5);
      fall.sprites[i].SetOpacity(1);
      fall.live[i] = 1;
      fall.vx[i] = (random() - 0.5) * 1.4;
      fall.vy[i] = -1 - random() * 1.5;   # small hop up before the drop
      return;
    }
  }
}

fun update_fall() {
  h = global.layout_height;
  for (i = 0; i < fall.max; i++) {
    if (fall.live[i] == 0)
      continue;
    fall.vy[i] += 0.18;                        # gravity, 50 fps
    x = fall.sprites[i].GetX() + fall.vx[i];
    y = fall.sprites[i].GetY() + fall.vy[i];
    fall.sprites[i].SetPosition(Math.Int(x), Math.Int(y), 5);
    if (y > h + 40) {
      fall.live[i] = 0;
      fall.sprites[i].SetOpacity(0);
    } else if (y > h - 120) {
      fall.sprites[i].SetOpacity(Math.Max(0, (h + 40 - y) / 160));
    }
  }
}

fun keyboard_input_callback(input) {
  cycle_state();
  if (input.Length() == 1 && input.CharAt(0) != "\e" && input.CharAt(0) >= " ")
    spawn_fall(input);
}

Plymouth.SetKeyboardInputFunction(keyboard_input_callback);

#----------------------------------------- Message --------------------------------

fun place_message() {
  w = message.image.GetWidth();
  h = message.image.GetHeight();
  x = Math.Int(global.layout_width / 2 - w / 2);
  message.sprite.SetPosition(x, global.message_y, 4);
  cursor.sprite.SetPosition(x + w + 8, global.message_y + Math.Int((h - cursor.image.GetHeight()) / 2), 4);
}

fun set_message(text) {
  global.message_text = text;
  p = palettes[global.palette];
  message.image = Image.Text(text, p.message[0], p.message[1], p.message[2], 1, global.font);
  message.sprite.SetImage(message.image);
  place_message();
}

fun display_message_callback(text) {
  set_message(text);
}

fun hide_message_callback(text) {
  if (text == global.message_text)
    set_message(global.default_text);
}

Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);

#----------------------------------------- Progress --------------------------------

fun draw_bar() {
  tw = track.image.GetWidth();
  src = bar.original;
  seg = bar.segment;
  if (global.palette == "red") {
    src = bar.original_red;
    seg = bar.segment_red;
  }
  if (global.progress > 0) {
    bw = Math.Int(tw * global.progress);
    if (bw < 1) bw = 1;
    bar.sprite.SetImage(src.Scale(bw, src.GetHeight()));
    bar.sprite.SetPosition(global.track_x, global.track_y, 3);
  } else {
    bar.sprite.SetImage(seg);
    sweep_bar();
  }
}

# Indeterminate: a short segment eases back and forth along the track.
fun sweep_bar() {
  span = track.image.GetWidth() - bar.segment.GetWidth();
  t = global.frame / 50;                               # refresh runs at 50 Hz
  pos = (Math.Sin(t * 2 * Math.Pi / 2.4) + 1) / 2;    # 2.4 s per round trip
  bar.sprite.SetPosition(global.track_x + Math.Int(pos * span), global.track_y, 3);
}

fun system_update_callback(progress) {
  p = progress;
  if (p > 1) p = p / 100;                              # plymouth sends a percentage
  if (p > 1) p = 1;
  if (p < 0) p = 0;
  global.progress = p;
  draw_bar();
}

Plymouth.SetSystemUpdateFunction(system_update_callback);

#----------------------------------------- Layout --------------------------------

fun layout() {
  global.layout_width = Window.GetWidth();
  global.layout_height = Window.GetHeight();
  w = global.layout_width;
  h = global.layout_height;
  p = palettes[global.palette];

  # Shrink the wordmark on narrow screens; never upscale (keeps pixels crisp).
  img = wordmark.original;
  if (global.palette == "red")
    img = wordmark.original_red;
  max_w = w - 64;
  global.wordmark_scale = 1;
  if (img.GetWidth() > max_w) {
    scale = max_w / img.GetWidth();
    global.wordmark_scale = scale;
    img = img.Scale(Math.Int(img.GetWidth() * scale), Math.Int(img.GetHeight() * scale));
  }
  wordmark.image = img;
  wordmark.sprite.SetImage(img);
  wordmark.y = Math.Int(h * 0.42 - img.GetHeight() / 2);
  wordmark.sprite.SetPosition(Math.Int(w / 2 - img.GetWidth() / 2), wordmark.y, 1);

  # Geometry the per-letter sprites need to tile exactly over the wordmark.
  global.wordmark_x = Math.Int(w / 2 - img.GetWidth() / 2);
  global.wordmark_y = wordmark.y;
  position_letters();

  # wordmark.png carries a 24 px transparent margin for its glow.
  global.track_x = Math.Int(w / 2 - track.image.GetWidth() / 2);
  global.track_y = wordmark.y + img.GetHeight() + 16;
  if (global.palette == "red")
    track.sprite.SetImage(track.image_red);
  else
    track.sprite.SetImage(track.image);
  track.sprite.SetPosition(global.track_x, global.track_y, 2);

  global.message_y = global.track_y + 28;
  place_message();

  version.image = Image.Text(global.version_text, p.version[0], p.version[1], p.version[2], 1, global.small_font);
  version.sprite.SetImage(version.image);
  version.sprite.SetPosition(w - version.image.GetWidth() - 16, h - version.image.GetHeight() - 14, 2);

  draw_bar();
}

#----------------------------------------- Refresh --------------------------------

fun refresh_callback() {
  global.frame++;

  # Displays can appear or resize after the script ran; re-center then.
  if (Window.GetWidth() != global.layout_width || Window.GetHeight() != global.layout_height)
    layout();

  if (global.progress == 0)
    sweep_bar();

  if (global.state == 1)
    update_flip();
  if (global.state == 3)
    update_rain();
  update_fall();

  # Blinking block cursor after the status line, 1 Hz.
  if (Math.Int(global.frame / 25) % 2 == 0)
    cursor.sprite.SetOpacity(1);
  else
    cursor.sprite.SetOpacity(0);
}

Plymouth.SetRefreshFunction(refresh_callback);

#----------------------------------------- Start --------------------------------

mode = Plymouth.GetMode();
if (mode == "shutdown" || mode == "reboot")
  global.default_text = "Finishing up";

set_message(global.default_text);
layout();
