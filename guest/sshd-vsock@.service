[Unit]
Description=sshd session over vsock (%i)
# Wait for the KVP-injected key so an early connection isn't rejected.
# (Ordering here is safe: the socket itself has no dependency on the
# injection service — ordering a plain service *before* a socket would
# cycle through basic.target <- sockets.target.)
After=inject-ssh-key.service

[Service]
# Generate host keys on first session of this boot (only creates missing
# ones — the ISO deliberately ships none, so every boot gets fresh keys
# instead of sharing one private key across all published ISOs).
ExecStartPre=/usr/bin/ssh-keygen -A
ExecStart=-/usr/sbin/sshd -i
StandardInput=socket
StandardOutput=socket
StandardError=socket
