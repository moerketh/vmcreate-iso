[Unit]
Description=sshd session over vsock (%i)
# Wait for the KVP-injected key so an early connection isn't rejected, and
# for host-key generation (oneshot, once per boot — NOT an ExecStartPre
# here: Accept=yes makes this unit start per connection, and concurrent
# queued sessions would race ssh-keygen -A against each other, handing the
# live session one key generation and the next connection another).
# Ordering a session (not the socket) after these services can't cycle.
Wants=sshd-vsock-keygen.service
After=inject-ssh-key.service sshd-vsock-keygen.service

[Service]
ExecStart=-/usr/sbin/sshd -i
StandardInput=socket
StandardOutput=socket
StandardError=socket
